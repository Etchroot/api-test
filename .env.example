# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 절대 커밋하지 않는다.
# 공공데이터포털 마이페이지 > 활용신청 현황 > 일반 인증키(Encoding)
DATA_GO_KR_KEY=여기에_Encoding_키

# 서비스 End Point (오퍼레이션명 /foodList, /foodCont 등은 server.js 가 붙인다)
FOOD_API_BASE=https://apis.data.go.kr/1390803/allbaroFoodMonth

PORT=3000
# 다른 도메인의 페이지에서 이 서버를 호출할 때만 지정 (예: https://my-site.github.io)
ALLOWED_ORIGIN=
